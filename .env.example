# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Anthropic API key (only if you call the API directly; the skills use the Claude Code CLI)
ANTHROPIC_API_KEY=

# Gmail account the agent sends from (use a Gmail App Password, not your login password)
EMAIL_ADDRESS=you@example.com
EMAIL_APP_PASSWORD=

# Where internal alerts (serious replies, preflight failures) are sent
INTERNAL_ALERT_EMAIL=you@example.com

# Display name on outgoing mail
FROM_NAME=Your Name

# Mail servers (defaults are Gmail)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional but recommended: Hunter.io API key for email verification.
# Works even when outbound port 25 is blocked (e.g. on a cloud VM), which is when
# the built-in SMTP probe can't run. Free tier (~50 verifications/month) covers
# the 2 cold emails/day cap. Without it, the agent still blocks dead domains but
# can't catch a wrong guessed mailbox on the VM. Get a key at https://hunter.io
HUNTER_API_KEY=
